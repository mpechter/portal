# Flask secret key (generate a random one for production)
SECRET_KEY=your-secret-key-here

# Resend API key for sending login code emails
# Get one at https://resend.com
# Leave empty to print codes to console (dev mode)
RESEND_API_KEY=re_xxxxxxxxxxxxx

# Email sender address (must be verified in Resend)
# Use onboarding@resend.dev for testing, or your own verified domain
EMAIL_FROM=onboarding@resend.dev

# Public URL of your portal (used for magic link URLs)
APP_URL=http://localhost:5000

# Database URL (defaults to SQLite in project directory)
# DATABASE_URL=sqlite:///portal.db

# Superadmin dashboard password (internal — protects /superadmin/users)
SUPERADMIN_PASSWORD=change-me

# Cloudflare R2 (logo uploads)
# Create an R2 API token at dash.cloudflare.com → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
# Enable public access on the bucket, then set this to the public URL base:
R2_PUBLIC_URL=https://pub-xxxx.r2.dev
