# Flask secret key (generate a random one for production)
SECRET_KEY=your-secret-key-here

# Resend API key for sending magic link emails
# Get one at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxx

# Public URL of your portal (used for magic link URLs)
APP_URL=http://localhost:5000

# Database URL (defaults to SQLite in project directory)
# DATABASE_URL=sqlite:///portal.db
